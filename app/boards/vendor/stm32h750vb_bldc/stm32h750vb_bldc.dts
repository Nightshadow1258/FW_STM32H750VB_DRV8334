/dts-v1/;
#include <st/h7/stm32h750Xb.dtsi>
#include <st/h7/stm32h750vbtx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "stm32h750vb_bldc.dtsi"


/ {
	model = "VCC-GND Studio STM32H750VB";
	compatible = "st,stm32h750vb";

	aliases {
		spi-flash0 = &w25q128jv;
		storage-flash = &storage_partition;
		meas-trigger = &meas_trigger;

	};

	chosen {
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,flash-controller = &w25q128jv;
	};

	leds {
		compatible = "gpio-leds";
		as5047p_cs: as5047p_cs {
			gpios = <&gpiod 6 GPIO_ACTIVE_LOW>;
			label = "AS5047P_CS";
		};
	};
	/* Define the Index Pin as a GPIO for Interrupt use */
	encoder_index: encoder_index {
		compatible = "gpio-keys";
		index_pin: index_pin {
			gpios = <&gpiob 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			label = "Encoder Index";
		};
	};

	// ADC
	zephyr,user {
		/* Expose the handles to your C code via an indexing array */
		io-channels = <&adc3 1>, <&adc2 5>, <&adc1 9>;
		io-channel-names = "SOA", "SOB", "SOC";
	};

	trigger_signal {
		compatible = "gpio-keys";
		meas_trigger: meas_trigger {
			gpios = <&gpiod 9 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
			label = "Measurement Trigger";
		};
	};

};

&clk_lse {
	status = "okay";
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(16)>;
	status = "okay";
};

&pll {
	div-m = <1>;
	mul-n = <60>;
	div-p = <2>;
	div-q = <15>;
	div-r = <6>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(480)>;
	d1cpre = <1>;   /* SYSCLK / 1 = 480MHz */
	hpre = <2>;    /* 480MHz / 2 = 240MHz (Max AHB speed) */
	d1ppre = <2>;  /* 240MHz / 2 = 120MHz (APB3) */
	d2ppre1 = <2>; /* 240MHz / 2 = 120MHz (APB1) */
	d2ppre2 = <2>; /* 240MHz / 2 = 120MHz (APB2) */
	d3ppre = <2>;  /* 240MHz / 2 = 120MHz (APB4) */
};

&pwr {
	power-supply = "ldo";
};

&usart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	current-speed = <115200>;
	status = "okay";
};

&pinctrl {
	spi3_sck_pc10: spi3_sck_pc10 {
		pinmux = <STM32_PINMUX('C', 10, AF6)>;
		bias-pull-down;
	};
	spi3_miso_pc11: spi3_miso_pc11 {
		pinmux = <STM32_PINMUX('C', 11, AF6)>;
		bias-pull-up;
	};
	spi3_mosi_pc12: spi3_mosi_pc12 {
		pinmux = <STM32_PINMUX('C', 12, AF6)>;
		bias-pull-down;
	};
};

&spi1 {
    pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pd7>;
    pinctrl-names = "default";
    status = "okay";
    cs-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;

    drv8334: drv8334@0 {
        compatible = "ti,drv8334";
        reg = <0>;
        spi-max-frequency = <10000000>;

        /* Control GPIOs */
        nsleep-gpios = <&gpiob 14 GPIO_ACTIVE_HIGH>;
        drvoff-gpios = <&gpiob 15 GPIO_ACTIVE_HIGH>;
        nfault-gpios = <&gpioe 15 GPIO_ACTIVE_LOW>;

        /* PWM Interface Pins */
        inha-gpios = <&gpioe 8 GPIO_ACTIVE_HIGH>;
        inla-gpios = <&gpioe 9 GPIO_ACTIVE_HIGH>;
        inhb-gpios = <&gpioe 10 GPIO_ACTIVE_HIGH>;
        inlb-gpios = <&gpioe 11 GPIO_ACTIVE_HIGH>;
        inhc-gpios = <&gpioe 12 GPIO_ACTIVE_HIGH>;
        inlc-gpios = <&gpioe 13 GPIO_ACTIVE_HIGH>;
    };
};

/* Note: ADC configuration for PC3_C, PB1, PB0 (SOA, SOB, SOC)
   would typically be handled via the ADC peripheral nodes. */

&spi3 {
	status = "okay";
	pinctrl-0 = <&spi3_sck_pc10 &spi3_miso_pc11 &spi3_mosi_pc12>;
	pinctrl-names = "default";
	// cs-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>; CS was not toggled
	// keep this for later testing if i want to make a driver package for the this sensor else delete it at the end.
	// as5047p@0 {
		//     status = "okay";
		//     compatible = "ams,as5047p";
		//     reg = <0>;
		//     spi-max-frequency = <10000000>;
	// };
};

//&sdmmc1 {
	//    pinctrl-names = "default";
	//    pinctrl-0 = <&sdmmc1_d0_pc8 &sdmmc1_d1_pc9
	//             &sdmmc1_d2_pc10 &sdmmc1_d3_pc11
	//             &sdmmc1_ck_pc12 &sdmmc1_cmd_pd2>;
	//    cd-gpios = <&gpioa 8 GPIO_ACTIVE_LOW>;
	//    disk-name = "SD";
	//    status = "okay";
//};

&quadspi {
	pinctrl-names = "default";
	pinctrl-0 = <&quadspi_clk_pb2 &quadspi_bk1_ncs_pb10
	&quadspi_bk1_io0_pd11 &quadspi_bk1_io1_pd12
	&quadspi_bk1_io2_pe2 &quadspi_bk1_io3_pd13>;
	status = "okay";

	w25q128jv: qspi-nor-flash@0 {
		compatible = "st,stm32-qspi-nor";
		reg = <0>;
		size = <DT_SIZE_M(128)>; /* 128 Mbits */
		qspi-max-frequency = <80000000>;
		cs-high-time = <4>; /* >= 50 ns */
		spi-bus-width = <4>;
		jedec-id = [ ef 40 18  ];
		status = "okay";
		/* Tell Zephyr to program the QE bit in Status Register 2 -> enables QSPI else only Singe Wire works*/
		quad-enable-requirements = "S2B1v1";
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			storage_partition: partition@0 {
				label = "storage";
				reg = <0x0 DT_SIZE_M(16)>;
			};
		};
	};
};


&timers2 {
	status = "okay";
	qdec: qdec {
		status = "okay";
		pinctrl-0 = <&tim2_ch1_pa15 &tim2_ch2_pb3>;
		pinctrl-names = "default";
		st,counts-per-revolution = <2048>;
		st,input-filter-level = <1>; // default is 0
	};
};

&adc1 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <1>;

	channel@9 {
		reg = <9>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	// broken due to internal use - not sure how to fix this yet, maybe use adc3 for temp sensor and adc1 for the 3 shunt voltages? or just use adc2 for the 3 shunt voltages and adc1 for the temp sensor? will have to test this out.
	// channel@10 {
	// 	reg = <10>;
	// 	zephyr,gain = "ADC_GAIN_1";
	// 	zephyr,reference = "ADC_REF_INTERNAL";
	// 	zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
	// 	zephyr,resolution = <12>;
	// };
};

&adc2 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <1>;

	channel@5 {
		reg = <5>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&adc3 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <1>;

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

